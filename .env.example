# Server Configuration
PROJECT_NAME="Supply Chain AI Decision-Intelligence"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Default to SQLite for local zero-dependency runs; use PostgreSQL for production/docker
DATABASE_URL="sqlite:///./supply_chain.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/supply_chain_db"

# GenAI / Claude Configuration
ANTHROPIC_API_KEY=""
AI_PROVIDER="claude" # options: "claude", "mock"

# Environment
ENVIRONMENT="development"
LOG_LEVEL="INFO"
